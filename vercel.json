{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "server/api/python/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/scrape",
      "destination": "/server/api/python/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/server/api/index.ts"
    }
  ]
}